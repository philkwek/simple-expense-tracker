{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "..",
    "outDir": "lib",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts",
    "../src/utils/periodCalculator.ts",
    "../src/utils/reminders.ts",
    "../src/types/expense.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}

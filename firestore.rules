rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file enforces the following data structures:
//
// Collection: users/{userId}/settings/{settingId}
// Document ID: 'preference'
// Fields:
//   - budget: number (required, 0 <= budget <= 100,000,000) - Periodic spending allowance
//   - cadence: string (required, enum: 'daily' | 'weekly' | 'monthly') - Reset cycle cadence
//   - periodStartDay: int (required, 0 <= periodStartDay <= 31) - Cycle cutoff hour/day/date
//   - currency: string (required, size == 3) - 3-letter ISO currency code (e.g., 'USD')
//   - updatedAt: number | timestamp (optional, >= 0 if number) - Last modification timestamp
//
// Collection: users/{userId}/budgets/{budgetId}
// Document ID: Auto-generated, or 'default' for the budget migrated from 'preference' (<= 128 chars)
// Fields:
//   - kind: string (optional, enum: 'recurring' | 'oneOff', missing = 'recurring',
//           immutable on update) - Whether the budget resets every cycle or runs once
//   - startDate, endDate: string (optional, 'YYYY-MM-DD', both or neither, one-off only)
//           - Inclusive local first and last day of a dated one-off budget
//   - name: string (required, 1 <= size <= 40) - Display name, e.g. "Groceries"
//   - amount: number (required, 0 <= amount <= 100,000,000) - Periodic spending allowance
//   - cadence: string (required, enum: 'daily' | 'weekly' | 'monthly') - Reset cycle cadence
//   - periodStartDay: int (required, 0 <= periodStartDay <= 31) - Cycle cutoff hour/day/date
//   - currency: string (required, size == 3) - 3-letter ISO currency code
//   - dailyTracking: bool (optional) - Show a rolling daily allowance (weekly/monthly only)
//   - reminders: map (optional) - Push reminder settings:
//       - enabled: bool - Whether reminders are currently sent
//       - times: list (<= 4 entries) - Local wall-clock "HH:mm" times, sorted and unique
//       - timeZone: string (1 <= size <= 64) - IANA time zone the times are in
//   - nextReminderAt: number (optional, >= 0) - Epoch ms of the next reminder to send;
//                     recomputed by the client on save and advanced by the sender function
//   - sortOrder: int (required, >= 0) - Position in the budget switcher
//   - createdAt: number | timestamp (required, immutable on update) - Record creation time
//   - updatedAt: number | timestamp (optional) - Last modification timestamp
//
// Collection: users/{userId}/private/{docId}
// Document ID: 'push' (the only document allowed in this subcollection)
// Fields:
//   - tokens: map (required, <= 10 entries) - Push tokens keyed by a short hash of the
//             token, each value holding { token: string, updatedAt: number }
//
// Collection: users/{userId}/expenses/{expenseId}
// Document ID: Auto-generated or restored document ID (<= 128 chars)
// Fields:
//   - title: string (required, 1 <= size <= 120) - Expense description/merchant
//   - amount: number (required, 0 <= amount <= 100,000,000) - Expense monetary amount
//   - timestamp: number | timestamp (required, >= 0 if number) - Epoch ms when expense occurred
//   - createdAt: number | timestamp (required, immutable on update, >= 0 if number) - Record creation time
//   - hasTime: bool (optional) - Whether a specific time of day was recorded (false for whole-day manual entries)
//   - budgetId: string (optional during rollout, 1 <= size <= 128) - Budget the expense counts against.
//               Can be added to an expense that lacks it (migration) but never changed once set.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the user-scoped resource path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate that all required fields exist on the incoming document
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only explicitly allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate that immutable fields are not modified during an update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Validate string type and length bounds to prevent Resource Exhaustion / DoS
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
             request.resource.data[field].size() >= minLen &&
             request.resource.data[field].size() <= maxLen;
    }

    // Validate numeric value (int or float) within inclusive range
    function isValidNumberInRange(val, minVal, maxVal) {
      return (val is int || val is float) &&
             val >= minVal &&
             val <= maxVal;
    }

    // Validate epoch milliseconds (int or float >= 0) or Firestore timestamp
    function isValidTimeValue(val) {
      return val is timestamp ||
             ((val is int || val is float) && val >= 0 && val <= 99999999999999);
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update rules)
    // ===============================================================

    function isValidUserSettings(data) {
      return hasOnlyAllowedFields(['budget', 'cadence', 'periodStartDay', 'currency', 'updatedAt']) &&
             hasRequiredFields(['budget', 'cadence', 'periodStartDay', 'currency']) &&
             isValidNumberInRange(data.budget, 0, 100000000) &&
             data.cadence is string &&
             data.cadence in ['daily', 'weekly', 'monthly'] &&
             data.periodStartDay is int &&
             data.periodStartDay >= 0 &&
             data.periodStartDay <= 31 &&
             validStringLength('currency', 3, 3) &&
             (!('updatedAt' in data) || isValidTimeValue(data.updatedAt));
    }

    function isValidBudget(data) {
      return hasOnlyAllowedFields(['kind', 'startDate', 'endDate', 'name', 'amount', 'cadence', 'periodStartDay', 'currency', 'dailyTracking', 'reminders', 'nextReminderAt', 'sortOrder', 'createdAt', 'updatedAt']) &&
             hasRequiredFields(['name', 'amount', 'cadence', 'periodStartDay', 'currency', 'sortOrder', 'createdAt']) &&
             validStringLength('name', 1, 40) &&
             isValidNumberInRange(data.amount, 0, 100000000) &&
             data.cadence is string &&
             data.cadence in ['daily', 'weekly', 'monthly'] &&
             data.periodStartDay is int &&
             data.periodStartDay >= 0 &&
             data.periodStartDay <= 31 &&
             validStringLength('currency', 3, 3) &&
             (!('kind' in data) || (data.kind is string && data.kind in ['recurring', 'oneOff'])) &&
             isValidBudgetDates(data) &&
             (!('dailyTracking' in data) || data.dailyTracking is bool) &&
             (!('reminders' in data) || isValidReminders(data.reminders)) &&
             (!('nextReminderAt' in data) || ((data.nextReminderAt is int || data.nextReminderAt is float) && data.nextReminderAt >= 0)) &&
             data.sortOrder is int &&
             data.sortOrder >= 0 &&
             isValidTimeValue(data.createdAt) &&
             (!('updatedAt' in data) || isValidTimeValue(data.updatedAt));
    }

    // One-off budgets may carry an inclusive [startDate, endDate] pair of 'YYYY-MM-DD' strings
    function isValidBudgetDates(data) {
      return (!('startDate' in data) && !('endDate' in data)) ||
             ('startDate' in data && 'endDate' in data &&
              data.get('kind', 'recurring') == 'oneOff' &&
              data.startDate is string && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
              data.endDate is string && data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
              data.startDate <= data.endDate);
    }

    // Push reminder settings attached to a budget
    function isValidReminders(r) {
      return r is map &&
             r.keys().hasOnly(['enabled', 'times', 'timeZone']) &&
             r.keys().hasAll(['enabled', 'times', 'timeZone']) &&
             r.enabled is bool &&
             r.times is list &&
             r.times.size() <= 4 &&
             r.timeZone is string &&
             r.timeZone.size() >= 1 &&
             r.timeZone.size() <= 64;
    }

    // budgetId may be added to a legacy expense, but never moved between budgets
    function isBudgetIdUnchanged() {
      return !('budgetId' in resource.data) ||
             request.resource.data.budgetId == resource.data.budgetId;
    }

    function isValidExpense(data) {
      return hasOnlyAllowedFields(['title', 'amount', 'timestamp', 'createdAt', 'hasTime', 'budgetId']) &&
             (!('budgetId' in data) || validStringLength('budgetId', 1, 128)) &&
             hasRequiredFields(['title', 'amount', 'timestamp', 'createdAt']) &&
             validStringLength('title', 1, 120) &&
             isValidNumberInRange(data.amount, 0, 100000000) &&
             isValidTimeValue(data.timestamp) &&
             isValidTimeValue(data.createdAt) &&
             (!('hasTime' in data) || data.hasTime is bool);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      // User Settings Document ('preference')
      match /settings/{settingId} {
        allow read: if isOwner(userId) && settingId == 'preference';
        allow create: if isOwner(userId) &&
                         settingId == 'preference' &&
                         isValidUserSettings(request.resource.data);
        allow update: if isOwner(userId) &&
                         settingId == 'preference' &&
                         isValidUserSettings(request.resource.data);
        allow delete: if isOwner(userId) && settingId == 'preference';
      }

      // User Budgets Subcollection
      match /budgets/{budgetId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         budgetId.size() <= 128 &&
                         isValidBudget(request.resource.data);
        allow update: if isOwner(userId) &&
                         isValidBudget(request.resource.data) &&
                         areImmutableFieldsUnchanged(['createdAt']) &&
                         request.resource.data.get('kind', 'recurring') == resource.data.get('kind', 'recurring');
        allow delete: if isOwner(userId);
      }

      // User Expenses Subcollection
      match /expenses/{expenseId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         expenseId.size() <= 128 &&
                         isValidExpense(request.resource.data);
        allow update: if isOwner(userId) &&
                         expenseId.size() <= 128 &&
                         isValidExpense(request.resource.data) &&
                         areImmutableFieldsUnchanged(['createdAt']) &&
                         isBudgetIdUnchanged();
        allow delete: if isOwner(userId);
      }

      // Private push-token document, written by the web client.
      match /private/{docId} {
        allow read, delete: if isOwner(userId) && docId == 'push';
        allow create, update: if isOwner(userId) &&
                                 docId == 'push' &&
                                 request.resource.data.keys().hasOnly(['tokens']) &&
                                 request.resource.data.tokens is map &&
                                 request.resource.data.tokens.size() <= 10;
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
